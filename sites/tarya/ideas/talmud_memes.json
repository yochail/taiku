      "דף",
      "עמוד ב",
      "מקור"
    ],
    "sentence_shapes": [
      "\"אף אחד:\\nX:\" ",
      "\"POV: X\" + (מקור)"
    ],
    "rhetorical_habits": [
      "תמיד מוסיף דף ועמוד",
      "צוחק על הוויכוח, לא על התורה",
      "ממחזר פורמטים של ממים"
    ]
  }
