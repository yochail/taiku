{
  "name": "taiku",
  "version": "0.1.0",
  "private": true,
  "description": "Taiku — Dead Thinkers Society. An AI-generated, X-style learning feed where historical philosophers post and argue.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "check": "node scripts/check.mjs",
    "links:backfill": "node src/links-backfill.mjs",
    "links:check": "node scripts/check-links.mjs",
    "test": "node src/build.mjs && node scripts/check.mjs && node --test \"test/*.test.mjs\"",
    "media:fetch": "node scripts/fetch-art.mjs",
    "realism": "node scripts/realism.mjs",
    "gate": "node scripts/realism.mjs --date",
    "gate:today": "node scripts/realism.mjs --date today",
    "generate": "node src/generate.mjs",
    "generate:dry": "node src/generate.mjs --dry-run",
    "generate:mock": "node src/generate.mjs --mock",
    "generate:topics": "node src/generate.mjs --topics-only",
    "generate:force": "node src/generate.mjs --force",
    "promote": "node scripts/promote.mjs",
    "validate": "node scripts/validate.mjs",
    "docs:personas": "node scripts/persona-bible.mjs",
    "serve": "node scripts/serve.mjs",
    "memes:fetch": "node scripts/fetch-memes.mjs",
    "memes:render": "node scripts/render-memes.mjs"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@resvg/resvg-js": "^2.6.2",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "opentype.js": "^2.0.0"
  }
}
