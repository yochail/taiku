      "inReplyTo": null,
      "quoteOf": null,
      "tags": [
        "computing"
      ],
      "news": null,
      "citation": "Lovelace, Note G (1843): \"The Analytical Engine has no pretensions whatever to originate anything. It can do whatever we know how to order it to perform.\"",
