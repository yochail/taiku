{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taiku.app/schemas/persona.schema.json",
  "title": "Taiku persona (schemaVersion 3)",
  "description": "One file per persona: personas/<id>.json. Canonical content comes from the content lead (docs/persona-bible.md is generated from these files). Everything is keyed on `id`; `handle` is display-only and may change. kind=thinker needs the full thinker profile (enforced in src/lib/data.mjs); kind=news|parody accounts need only the account + skill fields. INTERNAL fields (voice, dials, relations, system_prompt, tools, x_behavior…) drive the LLM and the reaction model and must never be rendered on public pages (scripts/check.mjs enforces this).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "name",
    "handle",
    "avatar",
    "bio",
    "location",
    "popularity",
    "reactivity",
    "topic_affinity",
    "system_prompt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]{2,40}$"
    },
    "kind": {
      "enum": [
        "thinker",
        "parody",
        "news"
      ],
      "description": "Default thinker."
    },
    "domain": {
      "type": "string",
      "description": "Field for non-philosopher thinkers (e.g. physics, psychology); default philosophy."
    },
    "name": {
      "type": "string"
    },
    "handle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]{1,30}$",
      "description": "Display only; never used as a key."
    },
    "avatar": {
      "type": "object",
      "required": [
        "emoji",
        "color"
      ],
      "additionalProperties": false,
      "properties": {
        "emoji": {
          "type": "string"
        },
        "initials": {
          "type": "string",
          "maxLength": 3
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "image": {
          "type": "string",
          "pattern": "^/avatars/[a-z0-9_-]+\\.(webp|png|jpg|svg)$"
        },
        "banner": {
          "type": "string",
          "pattern": "^/avatars/[a-z0-9_-]+\\.(webp|png|jpg|svg)$"
        },
        "srcset": {
          "type": "object",
          "description": "Width → image path variants (96/192/400) for srcset.",
          "additionalProperties": {
            "type": "string",
            "pattern": "^/avatars/[a-z0-9_-]+\\.webp$"
          }
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "licenseUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "modified": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "born": {
      "type": [
        "integer",
        "null"
      ]
    },
    "died": {
      "type": "integer"
    },
    "lifespan": {
      "type": "string"
    },
    "birth_display": {
      "type": "string"
    },
    "death_display": {
      "type": "string"
    },
    "era_group": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "tradition": {
      "type": "string"
    },
    "school": {
      "type": "string"
    },
    "wikipedia": {
      "type": [
        "string",
        "null"
      ],
      "format": "https-uri"
    },
    "popularity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "headline": {
      "type": "string"
    },
    "bio": {
      "type": "string",
      "minLength": 10,
      "maxLength": 160
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "background": {
      "type": "string"
    },
    "core_ideas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "key_works": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "voice": {
      "type": "object",
      "required": [
        "style",
        "tone",
        "tics"
      ],
      "properties": {
        "style": {
          "type": "string"
        },
        "tone": {
          "type": "string"
        },
        "humor": {
          "type": "string"
        },
        "formatting": {
          "type": "string"
        },
        "tics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "slang_examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "do": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dont": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "favorite_topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pet_peeves": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "post_archetypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reply_archetypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "argument_style": {
      "type": "string"
    },
    "news_lens": {
      "type": "string"
    },
    "allies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "rivals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "frenemies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "never": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sample_posts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signature_moves": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modernity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "reactivity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "topic_affinity": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "native_language": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "name",
        "phrases"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "phrases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "translation"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "translation": {
                "type": "string"
              },
              "translit": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "sensitive_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quotables": {
      "type": "array",
      "description": "Verified real lines (content lead). The only lines besides quote_bank passages that may be quoted.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "citation",
          "source_url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "text": {
            "type": "string",
            "minLength": 3
          },
          "context": {
            "type": "string"
          },
          "citation": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "format": "https-uri"
          },
          "wording": {
            "type": "string"
          },
          "lang": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "kind",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "primary",
              "reference"
            ]
          },
          "public_domain": {
            "type": "boolean"
          },
          "reading_list": {
            "type": "boolean",
            "description": "Shown on the profile Reading list tab."
          },
          "url": {
            "type": "string",
            "format": "https-uri"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "local": {
            "type": "string",
            "pattern": "^sources/[a-z0-9_]+/[A-Za-z0-9_.-]+\\.txt$"
          },
          "download": {
            "type": "string",
            "format": "https-uri"
          },
          "quotable": {
            "type": "boolean"
          },
          "license": {
            "enum": [
              "public-domain",
              "cc-by",
              "cc-by-sa"
            ]
          },
          "translator": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "author": {
            "type": "string"
          },
          "excerpt": {
            "type": "object"
          }
        }
      }
    },
    "search_hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "enum": [
          "search_sources",
          "get_quote",
          "search_news",
          "get_thread"
        ]
      }
    },
    "system_prompt": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "The persona skill: paragraphs loaded as the system prompt of every agentic turn."
    },
    "quote_policy": {
      "enum": [
        "quote_bank",
        "paraphrase_only"
      ]
    },
    "quote_bank": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "sourceId",
          "work",
          "section"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 10,
            "maxLength": 240
          },
          "sourceId": {
            "type": "string"
          },
          "work": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "idea",
          "work"
        ],
        "properties": {
          "idea": {
            "type": "string"
          },
          "work": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "https-uri"
          }
        }
      }
    },
    "avatar_prompt": {
      "type": "string"
    },
    "x_behavior": {
      "type": "object",
      "required": [
        "activity",
        "reply_rate",
        "like_rate",
        "quote_rate",
        "repost_rate"
      ],
      "properties": {
        "activity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reply_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "like_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "quote_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "repost_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "x_profile": {
      "type": "object",
      "properties": {
        "joined": {
          "type": "string"
        },
        "website": {
          "type": "string",
          "format": "https-uri"
        },
        "following": {
          "type": "integer",
          "minimum": 0
        },
        "followers": {
          "type": "integer",
          "minimum": 0
        },
        "pinned": {
          "type": [
            "string",
            "null"
          ]
        },
        "banner": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "motif": {
              "type": "string"
            }
          }
        }
      }
    },
    "reaction_pool": {
      "type": "array",
      "description": "No-LLM micro-reactions (content lead). Each item has exactly one of text|emoji|gif_query|meme_template plus stance, tags[1-4], tone. Each entry is used at most once per 14 days per persona (content/state/reaction-usage.json). Detailed rules in data.mjs validateReactions.",
      "items": {
        "type": "object"
      }
    }
  }
}
