{
  "_note": "Daily free-only fallback. Workers AI models share ONE 10,000-Neuron UTC-day pool; model caps are ceilings, not additional allowances. OpenRouter :free models share 50 requests; Groq is conservatively pooled at 1000 requests/200000 tokens. Gemini's 200 requests is an application ceiling, not a promise of free availability. Missing keys or free-only attestations skip paid-capable providers. The planner uses 100% of allowance, with 5% of calls reserved for rejected-item repairs. Request admission reserves UTF-8 input bytes plus tool overhead and the full output cap before EVERY HTTP attempt; reported usage releases only unused reservation, absent usage/failure keeps the full charge. Shared per-request ledger persists across sites, reruns, failures and repairs. neuronRate = Neurons per 1M input/output tokens. See README daily free-budget policy.",
  "freePools": {
    "OPENROUTER_API_KEY": { "calls": 50 },
    "GROQ_API_KEY": { "calls": 1000, "tokens": 200000 }
  },
  "totalCap": {
    "unit": "neurons",
    "cap": 10000
  },
  "planShare": 1,
  "reserveShare": 0.05,
  "targetCalls": {
    "min": 50,
    "max": 1000
  },
  "wallClockMinutes": 25,
  "discovery": "https://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT_ID}/ai/models/search?task=Text%20Generation",
  "chains": {
    "voice": [
      "gemini-3.5-flash",
      "or-nemotron-3-ultra",
      "or-nemotron-3.5-super",
      "cf-llama-3.3-70b"
    ],
    "batch": [
      "gemini-3.5-flash",
      "or-nemotron-3.5-super",
      "groq-gpt-oss-120b",
      "cf-gemma-4-26b"
    ],
    "micro": [
      "groq-qwen3.8-27b",
      "cf-gemma-4-26b-micro"
    ],
    "fallback": [
      "cf-gpt-oss-120b"
    ]
  },
  "spill": {
    "voice": [
      "voice",
      "fallback"
    ],
    "batch": [
      "batch",
      "micro",
      "fallback"
    ],
    "micro": [
      "micro",
      "batch",
      "fallback"
    ],
    "fallback": [
      "fallback"
    ]
  },
  "providers": [
    {
      "name": "cf-llama-3.3-70b",
      "baseURL": "https://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT_ID}/ai/v1",
      "keyEnv": "CF_AI_TOKEN",
      "model": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
      "role": "voice",
      "voiceWeight": 0.8,
      "tools": "auto",
      "capUnit": "neurons",
      "cap": 10000,
      "calls": 200,
      "rpm": 12,
      "max_tokens": 320,
      "temperature": 0.95,
      "extra": {},
      "neuronRate": {
        "input": 26668,
        "output": 204805
      },
      "est": {
        "input": 2600,
        "output": 160
      }
    },
    {
      "name": "cf-gemma-4-26b",
      "baseURL": "https://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT_ID}/ai/v1",
      "keyEnv": "CF_AI_TOKEN",
      "model": "@cf/google/gemma-4-26b-a4b-it",
      "role": "batch",
      "voiceWeight": 0,
      "tools": "auto",
      "capUnit": "neurons",
      "cap": 10000,
      "calls": 200,
      "rpm": 12,
      "max_tokens": 1600,
      "temperature": 0.95,
      "extra": { "chat_template_kwargs": { "enable_thinking": false } },
      "_note": "Reasoning model: below ~1500 max_tokens the reasoning eats the budget and content comes back empty, so thinking is off (chat_template_kwargs): ~8x fewer tokens, no empty replies.",
      "neuronRate": {
        "input": 9091,
        "output": 27273
      },
      "est": {
        "input": 2500,
        "output": 1000
      }
    },
    {
      "name": "cf-gemma-4-26b-micro",
      "baseURL": "https://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT_ID}/ai/v1",
      "keyEnv": "CF_AI_TOKEN",
      "model": "@cf/google/gemma-4-26b-a4b-it",
      "role": "micro",
      "voiceWeight": 0,
      "tools": "off",
      "capUnit": "neurons",
      "cap": 10000,
      "calls": 200,
      "rpm": 12,
      "max_tokens": 700,
      "temperature": 0.9,
      "extra": { "chat_template_kwargs": { "enable_thinking": false } },
      "_note": "Same model and shared Workers AI pool as cf-gemma-4-26b, not an independent allowance. Thinking stays off via chat_template_kwargs to avoid empty content. The planner's role allocation is elastic; request admission enforces the shared pool.",
      "neuronRate": {
        "input": 9091,
        "output": 27273
      },
      "est": {
        "input": 1500,
        "output": 250
      }
    },
    {
      "name": "cf-gpt-oss-120b",
      "baseURL": "https://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT_ID}/ai/v1",
      "keyEnv": "CF_AI_TOKEN",
      "model": "@cf/openai/gpt-oss-120b",
      "role": "fallback",
      "voiceWeight": 0.2,
      "tools": "auto",
      "capUnit": "neurons",
      "cap": 10000,
      "calls": 200,
      "rpm": 12,
      "max_tokens": 900,
      "temperature": 0.9,
      "extra": {
        "reasoning_effort": "low"
      },
      "neuronRate": {
        "input": 31818,
        "output": 68182
      },
      "est": {
        "input": 2000,
        "output": 450
      }
    },
    {
      "name": "gemini-3.5-flash",
      "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai",
      "keyEnv": "GEMINI_API_KEY",
      "model": "gemini-3.5-flash",
      "role": "voice",
      "voiceWeight": 0,
      "tools": "on",
      "capUnit": "requests",
      "cap": 200,
      "calls": 200,
      "rpm": 8,
      "max_tokens": 2000,
      "temperature": 0.95,
      "extra": {},
      "_note": "Best all-rounder (voice + batch JSON). Uses em-dashes; the house-style lint strips them."
    },
    {
      "name": "or-nemotron-3-ultra",
      "baseURL": "https://openrouter.ai/api/v1",
      "keyEnv": "OPENROUTER_API_KEY",
      "model": "nvidia/nemotron-3-ultra-550b-a55b:free",
      "role": "voice",
      "voiceWeight": 0,
      "tools": "off",
      "capUnit": "requests",
      "cap": 50,
      "calls": 50,
      "rpm": 6,
      "max_tokens": 1200,
      "temperature": 0.95,
      "headers": {
        "HTTP-Referer": "https://taiku.app",
        "X-Title": "Taiku"
      },
      "extra": { "reasoning": { "enabled": false } },
      "_note": "Top voice quality in the test, but slow (7-28s). Shares the OpenRouter free quota. reasoning is off: with it on (the default since Nov 2026) the reasoning eats max_tokens and content comes back null."
    },
    {
      "name": "or-nemotron-3.5-super",
      "baseURL": "https://openrouter.ai/api/v1",
      "keyEnv": "OPENROUTER_API_KEY",
      "model": "nvidia/nemotron-3.5-super-vl:free",
      "role": "batch",
      "voiceWeight": 0,
      "tools": "off",
      "capUnit": "requests",
      "cap": 50,
      "calls": 50,
      "rpm": 6,
      "max_tokens": 1600,
      "temperature": 0.95,
      "headers": {
        "HTTP-Referer": "https://taiku.app",
        "X-Title": "Taiku"
      },
      "extra": { "reasoning": { "enabled": false } }
    },
    {
      "name": "groq-gpt-oss-120b",
      "baseURL": "https://api.groq.com/openai/v1",
      "keyEnv": "GROQ_API_KEY",
      "model": "openai/gpt-oss-120b",
      "role": "batch",
      "voiceWeight": 0,
      "tools": "on",
      "capUnit": "requests",
      "cap": 1000,
      "calls": 1000,
      "rpm": 20,
      "max_tokens": 1600,
      "temperature": 0.9,
      "extra": {
        "reasoning_effort": "low"
      },
      "_note": "Reliable JSON, blander voice; batch fallback only."
    },
    {
      "name": "groq-qwen3.8-27b",
      "baseURL": "https://api.groq.com/openai/v1",
      "keyEnv": "GROQ_API_KEY",
      "model": "qwen/qwen3.8-27b",
      "role": "micro",
      "voiceWeight": 0,
      "tools": "off",
      "capUnit": "requests",
      "cap": 1000,
      "calls": 1000,
      "rpm": 20,
      "max_tokens": 700,
      "temperature": 0.9,
      "userPrefix": "/no_think",
      "extra": {},
      "_note": "Fast; adds hashtags and runs long, so the lint strips hashtags and the 280 check regenerates."
    }
  ]
}
