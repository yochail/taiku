{
  "_note": "Generic provider list for the daily generator (src/lib/rotation.mjs). Cloudflare Workers AI free tier: 10,000 Neurons/day per account, reset 00:00 UTC; Taiku budgets 8,000. cap is in capUnit per UTC day; the planner uses at most planShare of it and keeps reserveShare of that for regenerating rejected items. neuronRate = Neurons per 1M input/output tokens (developers.cloudflare.com/workers-ai/platform/pricing). est = typical tokens per call for planning. baseURL/keyEnv are resolved from env at run time; secrets: CF_ACCOUNT_ID, CF_AI_TOKEN.",
  "totalCap": { "unit": "neurons", "cap": 8000 },
  "planShare": 0.8,
  "reserveShare": 0.1,
  "targetCalls": { "min": 50, "max": 90 },
  "wallClockMinutes": 25,
  "discovery": "https://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT_ID}/ai/models/search?task=Text%20Generation",
  "providers": [
    {
      "name": "cf-llama-3.3-70b",
      "baseURL": "https://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT_ID}/ai/v1",
      "keyEnv": "CF_AI_TOKEN",
      "model": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
      "role": "voice",
      "voiceWeight": 0.8,
      "tools": "auto",
      "capUnit": "neurons",
      "cap": 4000,
      "calls": 35,
      "rpm": 12,
      "max_tokens": 320,
      "temperature": 0.95,
      "extra": {},
      "neuronRate": { "input": 26668, "output": 204805 },
      "est": { "input": 2600, "output": 160 }
    },
    {
      "name": "cf-gemma-4-26b",
      "baseURL": "https://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT_ID}/ai/v1",
      "keyEnv": "CF_AI_TOKEN",
      "model": "@cf/google/gemma-4-26b-a4b-it",
      "role": "batch",
      "voiceWeight": 0,
      "tools": "auto",
      "capUnit": "neurons",
      "cap": 1500,
      "calls": 30,
      "rpm": 12,
      "max_tokens": 1600,
      "temperature": 0.95,
      "extra": {},
      "_note": "Reasoning model: below ~1500 max_tokens the reasoning eats the budget and content comes back empty.",
      "neuronRate": { "input": 9091, "output": 27273 },
      "est": { "input": 2500, "output": 1000 }
    },
    {
      "name": "cf-qwen3-30b",
      "baseURL": "https://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT_ID}/ai/v1",
      "keyEnv": "CF_AI_TOKEN",
      "model": "@cf/qwen/qwen3-30b-a3b-fp8",
      "role": "micro",
      "voiceWeight": 0,
      "tools": "off",
      "capUnit": "neurons",
      "cap": 700,
      "calls": 50,
      "rpm": 12,
      "max_tokens": 700,
      "temperature": 0.9,
      "userPrefix": "/no_think",
      "extra": {},
      "neuronRate": { "input": 4625, "output": 30475 },
      "est": { "input": 1500, "output": 250 }
    },
    {
      "name": "cf-gpt-oss-120b",
      "baseURL": "https://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT_ID}/ai/v1",
      "keyEnv": "CF_AI_TOKEN",
      "model": "@cf/openai/gpt-oss-120b",
      "role": "fallback",
      "voiceWeight": 0.2,
      "tools": "auto",
      "capUnit": "neurons",
      "cap": 1000,
      "calls": 10,
      "rpm": 12,
      "max_tokens": 900,
      "temperature": 0.9,
      "extra": { "reasoning_effort": "low" },
      "neuronRate": { "input": 31818, "output": 68182 },
      "est": { "input": 2000, "output": 450 }
    }
  ],
  "spill": {
    "voice": ["voice", "fallback"],
    "batch": ["batch", "micro", "fallback"],
    "micro": ["micro", "batch", "fallback"],
    "fallback": ["fallback"]
  }
}
